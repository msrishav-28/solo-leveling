# ============================================================================
# Solo Leveling — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
# Never commit the real `.env` (it is git-ignored).
# ============================================================================

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
VITE_SUPABASE_URL=your_project_url_here

# The Supabase "anon" public API key (safe to expose to the browser; access is
# constrained by Row Level Security). Do NOT use the service_role key here.
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ----------------------------------------------------------------------------
# NOTE: The optional AI quest-flavoring uses an ANTHROPIC_API_KEY, but that is a
# SERVER-SIDE secret for the `systemize` Supabase Edge Function — it must NOT go
# in this client .env. Set it as a Supabase secret instead:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ----------------------------------------------------------------------------
